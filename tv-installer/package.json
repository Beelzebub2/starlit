{
  "name": "starlit-tv-installer",
  "version": "0.1.0",
  "private": true,
  "description": "Starlit TV installer for Samsung Tizen and LG webOS",
  "main": "src/main.cjs",
  "scripts": {
    "prestart": "node scripts/copy-brand-fonts.cjs",
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "lint": "node --check src/main.cjs && node --check src/preload.cjs && node --check src/renderer.js && node --check src/installer.cjs && node --check src/ipk.cjs && node --check src/wgt.cjs && node --check src/samsung.cjs && node --check src/samsung-auth.cjs && node --check src/platforms.cjs && node --check src/discovery.cjs && node --check src/releases.cjs && node --check scripts/copy-brand-fonts.cjs",
    "predist:win": "node scripts/copy-brand-fonts.cjs",
    "dist:win": "electron-builder --win nsis portable --publish never"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "@webos-tools/cli": "3.2.6",
    "jszip": "3.10.1"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "app.starlit.tvinstaller",
    "productName": "Starlit TV Installer",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/@webos-tools/cli/**"
    ],
    "files": [
      "src/**/*",
      "build/icon.ico",
      "installer.config.json",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "signExecutable": false,
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Starlit-TV-Installer-Windows-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "artifactName": "Starlit-TV-Installer-Setup-Windows-${version}.${ext}"
    }
  }
}
